-void setup() {
-  // USB debug
-  Serial.begin(921600);
-  delay(100);
-
-  // Servo bus UART @ 1 Mbps
-  Serial2.begin(1000000, SERIAL_8N1, SERIAL2_RX_PIN, SERIAL2_TX_PIN);
-  hlscl.pSerial = &Serial2;
-
